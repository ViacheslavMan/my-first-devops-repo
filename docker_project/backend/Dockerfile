# взять образ с компилятором GO
FROM golang:1.22-alpine AS builder 
#создается рабочая папка build 
WORKDIR /build 

# сначала копируют только зависимости, тк они будут браться из кеша
COPY go.mod go.sum ./
# скачивает библиотеки и кеширует каждый слой, поэтому пересборка быстрая, 
# те код изменили а библиотека берется из кеша
RUN go mod download
# cкачиваются зависимости

# исходники копируются после бибилотеки, тк они меняются часто и ели бы стояло до,
# зависимсоти качались бы каждый раз
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /out/app ./main.go
# компиляция под линукс ldflags="-s -w" убирает отладочную инфу


#итоговый образ в который попадет только бинарник, комплиятор остается в первом образе
# нет пакетного менджера и shell для безопасности 
# процесс работает не от root для безопасноти
FROM gcr.io/distroless/static-debian12:nonroot
WORKDIR /app
COPY --from=builder /out/app /app/app
# копируеи файл с первого этапа
EXPOSE 8080
# слушает порт 8080, сам порт не открывается
ENTRYPOINT ["/app/app"]
#команда запускает  бинарник
